<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>a1_mola_localization</name>
  <version>0.1.0</version>
  <description>LiDAR-only MOLA-LO mapping and localization integration for the A1 PandarXT.</description>
  <maintainer email="sungho@todo.todo">sungho</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>a1_lidar_bringup</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>mola_bridge_ros2</exec_depend>
  <exec_depend>mola_lidar_odometry</exec_depend>
  <exec_depend>mola_launcher</exec_depend>
  <exec_depend>mola_msgs</exec_depend>
  <exec_depend>mola_state_estimation_simple</exec_depend>
  <exec_depend>mola_viz</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
